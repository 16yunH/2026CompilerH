build vendor/tinyxml2/CMakeFiles/vendor_xml.dir/tinyxml2.cc.o: CXX_COMPILER__vendor_xml_Release ../vendor/tinyxml2/tinyxml2.cc || cmake_object_order_depends_target_vendor_xml
  DEP_FILE = vendor/tinyxml2/CMakeFiles/vendor_xml.dir/tinyxml2.cc.o.d
  FLAGS = -Wno-unused-result --std=c++17 -O3 -DNDEBUG -std=gnu++17
  INCLUDES = -I../include/ast -I../include/ir -I../include/util -I../vendor/tinyxml2
  OBJECT_DIR = vendor/tinyxml2/CMakeFiles/vendor_xml.dir
  OBJECT_FILE_DIR = vendor/tinyxml2/CMakeFiles/vendor_xml.dir
  TARGET_COMPILE_PDB = vendor/tinyxml2/CMakeFiles/vendor_xml.dir/
  TARGET_PDB = ""



#############################################
# Object library vendor_xml

build vendor/tinyxml2/vendor_xml: phony vendor/tinyxml2/CMakeFiles/vendor_xml.dir/tinyxml2.cc.o

