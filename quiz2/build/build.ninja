build ast: phony lib/ast/ast

build ir: phony lib/ir/ir

build main: phony tools/main/main

build patchdemo: phony tools/patchdemo/patchdemo

build util: phony lib/util/util

build vendor_xml: phony vendor/tinyxml2/vendor_xml

