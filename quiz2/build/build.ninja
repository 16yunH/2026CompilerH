  COMMAND = cd /home/yunhong16/CompilerH/quiz2/build/vendor/tinyxml2 && /usr/bin/cmake --regenerate-during-build -S/home/yunhong16/CompilerH/quiz2 -B/home/yunhong16/CompilerH/quiz2/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build vendor/tinyxml2/rebuild_cache: phony vendor/tinyxml2/CMakeFiles/rebuild_cache.util

# =============================================================================
